# ── Database (Postgres) ─────────────────────────────────────────────────────
# Local:   postgresql://USER:PASSWORD@localhost:5432/blanca_admin?schema=public
# Supabase: use the "Connection string" → "URI" (session pooler) from the dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/blanca_admin?schema=public"

# ── Admin panel auth (password-via-env) ─────────────────────────────────────
# The single password that unlocks /admin.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Any long random string.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# ── Public site URL (used for OG/canonical + absolute links) ────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Optional tracking IDs already wired in the landing page ─────────────────
# NEXT_PUBLIC_GTM_ID="GTM-K8NP5ZS2"
# NEXT_PUBLIC_META_PIXEL_ID=""
# NEXT_PUBLIC_LEAD_WEBHOOK=""
