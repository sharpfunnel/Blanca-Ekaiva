# ── Database (Postgres) ─────────────────────────────────────────────────────
# Local:   postgresql://USER:PASSWORD@localhost:5432/blanca_admin?schema=public
# Supabase: use the "Connection string" → "URI" (session pooler) from the dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/blanca_admin?schema=public"

# ── Admin panel auth (password-via-env) ─────────────────────────────────────
# The single password that unlocks /admin.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Any long random string.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# ── Public site URL (used for OG/canonical + absolute links) ────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Optional tracking IDs already wired in the landing page ─────────────────
# NEXT_PUBLIC_GTM_ID="GTM-K8NP5ZS2"
# NEXT_PUBLIC_LEAD_WEBHOOK=""

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# The SAME pixel/dataset id goes in both vars. The browser cannot read the
# server one, and the token-bearing server code must not read a NEXT_PUBLIC_
# one. Set only one and half the integration silently no-ops.
# NEXT_PUBLIC_* is inlined at BUILD time — changing it needs a redeploy.
# NEXT_PUBLIC_META_PIXEL_ID=""
# META_PIXEL_ID=""
# System User access token from Meta Events Manager → Conversions API.
# Without it (in non-production) the admin "Send" button returns a local preview.
# META_CAPI_ACCESS_TOKEN=""
# Graph API version. Defaults to v21.0 in code.
# META_GRAPH_API_VERSION="v21.0"
# ⚠ ONLY while testing, and ONLY the "Website" channel's code from Events
# Manager → Test events. Left set in production every real conversion lands in
# the test panel and counts as zero.
# META_CAPI_TEST_EVENT_CODE=""
