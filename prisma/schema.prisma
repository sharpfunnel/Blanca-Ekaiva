// Analytics + CRM data model for the Blanca /admin panel.
// Postgres. Every visitor, session, event, replay chunk and lead is captured
// here by the tracking SDK (lib/track) via the ingest API routes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app at runtime (Neon PgBouncer).
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations / db push. Falls back to
  // DATABASE_URL when DIRECT_URL is not set.
  directUrl = env("DIRECT_URL")
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  SMART_TV
  BOT
  UNKNOWN
}

enum SessionStatus {
  ACTIVE
  IDLE
  ENDED
  BOUNCED
}

enum VisitorType {
  NEW
  RETURNING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  INTERESTED
  SITE_VISIT_SCHEDULED
  NEGOTIATION
  WON
  LOST
  SPAM
}

// Every discrete interaction. Click x/y power the click heatmap; SECTION_VIEW
// + SCROLL power the scroll heatmap and funnel; the rest feed the event stream.
enum EventType {
  PAGEVIEW
  CLICK
  RAGE_CLICK
  CTA_CLICK
  ANCHOR_CLICK
  PHONE_CLICK
  WHATSAPP_CLICK
  EMAIL_CLICK
  DOWNLOAD_BROCHURE
  BOOK_SITE_VISIT
  FORM_OPEN
  FORM_CLOSE
  FORM_START
  FORM_SUBMIT
  SECTION_VIEW
  SCROLL
  VIDEO_PLAY
  IMAGE_CLICK
  OUTBOUND_LINK
  HOVER
  LEAD
  // Frustration signals — a click that produced no DOM change (DEAD_CLICK) or
  // three-plus clicks on the same element inside a second (RAGE_CLICK above).
  DEAD_CLICK
  // CTA lifecycle, keyed by `data-cta-id`. CTA_CLICK above completes the set.
  CTA_VIEW
  CTA_HOVER
  // Form lifecycle beyond open/start/submit, keyed by `data-form-id`.
  FIELD_FOCUS
  FIELD_COMPLETE
  VALIDATION_ERROR
  FORM_ABANDON
}

/**
 * Google's Core Web Vitals thresholds.
 */
enum VitalRating {
  GOOD
  NEEDS_IMPROVEMENT
  POOR
}

enum ErrorKind {
  JS_ERROR
  UNHANDLED_REJECTION
  RESOURCE_ERROR
}

model Visitor {
  id           String   @id @default(cuid())
  visitorId    String   @unique
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  sessionCount Int      @default(0)
  leadCount    Int      @default(0)
  isReturning  Boolean  @default(false)

  sessions Session[]
  leads    Lead[]

  @@index([lastSeenAt])
}

model Session {
  id           String        @id @default(cuid())
  sessionId    String        @unique
  visitor      Visitor       @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  visitorId    String
  visitorType  VisitorType   @default(NEW)
  startedAt    DateTime      @default(now())
  lastActiveAt DateTime      @default(now())
  endedAt      DateTime?
  durationMs   Int           @default(0)
  status       SessionStatus @default(ACTIVE)

  // Network / geo (filled server-side from edge geo headers)
  ip          String?
  country     String?
  countryCode String?
  city        String?
  region      String?
  timezone    String?
  language    String?
  network     String?

  // Device / client
  device         DeviceType @default(UNKNOWN)
  os             String?
  osVersion      String?
  browser        String?
  browserVersion String?
  screenW        Int?
  screenH        Int?
  viewportW      Int?
  viewportH      Int?

  // Acquisition
  referrer       String?
  trafficSource  String? // google, facebook, instagram, direct, whatsapp...
  trafficMedium  String? // organic, cpc, referral, social, email...
  campaign       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  // Ad-platform click IDs + Meta ad-hierarchy params (when tagging own ads)
  gclid          String? // Google Ads
  fbclid         String? // Meta
  msclkid        String? // Microsoft Ads
  placement      String?
  metaCampaignId String?
  metaAdsetId    String?
  metaAdId       String?
  // Catch-all: every query param on the landing URL, verbatim, as JSON
  rawParams      Json?
  landingPage    String?
  exitPage       String?
  currentPage    String?

  // Engagement counters (denormalized; updated as events arrive)
  pageViews     Int     @default(0)
  clicks        Int     @default(0)
  mouseMoves    Int     @default(0)
  maxScrollPct  Int     @default(0)
  avgScrollPct  Int     @default(0)
  ctaClicked    Boolean @default(false)
  formStarted   Boolean @default(false)
  formSubmitted Boolean @default(false)
  isBounce      Boolean @default(true)
  isConverted   Boolean @default(false)

  events       Event[]
  pages        PageViewRec[]
  replayEvents ReplayEvent[]
  vitals       PerformanceMetric[]
  errors       ErrorEvent[]
  lead         Lead?

  @@index([startedAt])
  @@index([status])
  @@index([country])
  @@index([device])
  @@index([trafficSource])
  @@index([utmSource, utmMedium, utmCampaign])
  @@index([metaCampaignId])
}

model PageViewRec {
  id           String    @id @default(cuid())
  session      Session   @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  sessionId    String
  path         String
  title        String?
  enteredAt    DateTime  @default(now())
  leftAt       DateTime?
  timeOnMs     Int       @default(0)
  maxScrollPct Int       @default(0)

  @@index([sessionId])
  @@index([path])
}

model Event {
  id        String      @id @default(cuid())
  session   Session     @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  sessionId String
  type      EventType
  path      String?
  selector  String? // CSS-ish selector of the target element
  text      String? // trimmed label/text of the target
  x         Int? // click/hover viewport coordinate
  y         Int?
  pageX     Int? // absolute document coordinate
  pageY     Int?
  relX      Float? // 0..1 across page width — keeps heatmap responsive
  relY      Float? // 0..1 down full document height
  vpW       Int?
  vpH       Int?
  scrollPct Int?
  device    DeviceType?
  // Stable keys from markup, NOT derived from the DOM: tagging an element
  // `data-cta-id="hero-call"` is the whole convention for tracking it, so these
  // survive a class rename or a redesign in a way `selector` never can.
  ctaId     String?
  formId    String?
  fieldName String?
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([path])
  @@index([createdAt])
  @@index([type, path])
  @@index([ctaId])
  @@index([formId])
}

// Core Web Vitals, one row per metric per page load (web-vitals reports each
// metric once, at its final value).
model PerformanceMetric {
  id        String      @id @default(cuid())
  session   Session     @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  sessionId String
  name      String // LCP | INP | CLS | FCP | TTFB
  value     Float
  rating    VitalRating
  path      String?
  device    DeviceType?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([name])
  @@index([createdAt])
}

// Client-side errors: thrown exceptions, unhandled rejections, broken assets.
model ErrorEvent {
  id        String      @id @default(cuid())
  session   Session     @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  sessionId String
  kind      ErrorKind
  message   String
  source    String? // script URL, or the asset URL for RESOURCE_ERROR
  lineNo    Int?
  colNo     Int?
  stack     String?
  path      String?
  browser   String?
  os        String?
  device    DeviceType?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@index([kind])
  @@index([createdAt])
}

// rrweb event chunks for full session replay, batched to keep rows sane.
model ReplayEvent {
  id        String   @id @default(cuid())
  session   Session  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  sessionId String
  seq       Int
  events    Json // array of rrweb events
  createdAt DateTime @default(now())

  @@index([sessionId, seq])
}

model Lead {
  id        String   @id @default(cuid())
  session   Session? @relation(fields: [sessionId], references: [sessionId])
  sessionId String?  @unique
  visitor   Visitor? @relation(fields: [visitorId], references: [visitorId])
  visitorId String?

  name     String
  phone    String
  email    String?
  interest String? // Office / Retail / Both
  budget   String?
  message  String?
  city     String?
  country  String?

  source      String?
  campaign    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  device    DeviceType?
  browser   String?
  os        String?
  ip        String?
  /**
   * Raw User-Agent header at submit time — sent unhashed to Meta as
   * `client_user_agent`; it must pair with the IP that saw the click.
   */
  userAgent String?

  // Meta browser cookies, captured client-side when the form is submitted.
  // Sent to the Conversions API unhashed; the single biggest lever on Event
  // Match Quality after email/phone.
  fbp String? // _fbp — browser id set by the Pixel
  fbc String? // _fbc — click id, format fb.1.<click_ms>.<fbclid>

  status     LeadStatus @default(NEW)
  assignedTo String?

  // Meta Conversions API (server-side) send status. Exactly one is meaningful
  // at a time: a success sets metaCapiSentAt and clears metaCapiError.
  metaCapiSentAt  DateTime?
  metaCapiEventId String?
  metaCapiError   String?

  notes      LeadNote[]
  activities LeadActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([source])
}

model LeadNote {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  author    String?
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  type      String // status_change | note_added | contacted | assigned ...
  detail    String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

/**
 * ── Meta Ads ───────────────────────────────────────────────────────────────
 * Synced from the Graph API by lib/meta/sync.ts. Nothing here is written by
 * the site itself; it is a local mirror of what Meta reports, joined against
 * our own sessions/leads by campaign/adset/ad id so spend can sit next to the
 * conversions it actually produced.
 * ───────────────────────────────────────────────────────────────────────────
 */

model MetaAdAccount {
  id        String  @id @default(cuid())
  /**
   * Meta's `act_<id>` account id, without the `act_` prefix.
   */
  accountId String  @unique
  name      String?
  currency  String? // account currency — spend is reported in it, not INR
  timezone  String?

  /**
   * Long-lived user token. Server-only; never leaves the API layer.
   */
  accessToken    String?
  tokenExpiresAt DateTime?

  lastSyncedAt  DateTime?
  lastSyncError String?

  campaigns MetaCampaign[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model MetaCampaign {
  id             String        @id @default(cuid())
  account        MetaAdAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  accountId      String
  /**
   * Meta's campaign id — also what lands in Session.metaCampaignId.
   */
  campaignId     String        @unique
  name           String
  status         String?
  objective      String?
  dailyBudget    Float?
  lifetimeBudget Float?
  startTime      DateTime?
  stopTime       DateTime?

  adSets    MetaAdSet[]
  insights  MetaInsight[]
  updatedAt DateTime      @updatedAt

  @@index([accountId])
}

model MetaAdSet {
  id               String       @id @default(cuid())
  campaign         MetaCampaign @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  campaignId       String
  adSetId          String       @unique
  name             String
  status           String?
  dailyBudget      Float?
  lifetimeBudget   Float?
  optimizationGoal String?

  ads       MetaAd[]
  updatedAt DateTime @updatedAt

  @@index([campaignId])
}

model MetaAd {
  id               String    @id @default(cuid())
  adSet            MetaAdSet @relation(fields: [adSetId], references: [adSetId], onDelete: Cascade)
  adSetId          String
  adId             String    @unique
  name             String
  status           String?
  creativeThumbUrl String?

  updatedAt DateTime @updatedAt

  @@index([adSetId])
}

/**
 * One row per entity per day. `level` + `entityId` rather than three nullable
 * FKs, so campaign/adset/ad insights share one table and one query path.
 */
model MetaInsight {
  id       String   @id @default(cuid())
  level    String // campaign | adset | ad
  entityId String
  date     DateTime @db.Date

  /**
   * Set only for level="campaign", so campaign pages can join without a lookup.
   */
  campaign   MetaCampaign? @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  campaignId String?

  spend         Float @default(0)
  impressions   Int   @default(0)
  clicks        Int   @default(0)
  reach         Int   @default(0)
  ctr           Float @default(0)
  cpc           Float @default(0)
  cpm           Float @default(0)
  /**
   * Meta's attributed conversions for the account's chosen result type.
   */
  results       Int   @default(0)
  costPerResult Float @default(0)

  createdAt DateTime @default(now())

  @@unique([level, entityId, date])
  @@index([campaignId])
  @@index([date])
}
